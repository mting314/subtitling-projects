[
  {
    "id": 0,
    "text": "しずくもなんか、あ息がしやすいって言ってたけどそのなんだろう、",
    "start_time": 2311.92,
    "end_time": 2319.12,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 1,
    "text": "ほらあるじゃない。",
    "start_time": 2319.12,
    "end_time": 2320.42,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 2,
    "text": "そのさっきもあったけどさ仕事をしてて、あ、気張るぞタイムとこうふっと気を抜けて息がしやすいなっていう空間を作るのとこう大事だなっていうのも感じたしそのみのりちゃん改めてありがとうとも感じたから",
    "start_time": 2320.42,
    "end_time": 2335.04,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 3,
    "text": "本当だね。",
    "start_time": 2335.04,
    "end_time": 2335.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "分かる。 なんかみのりに感謝したくなる。",
    "start_time": 2335.84,
    "end_time": 2338.0,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "そう。",
    "start_time": 2337.91,
    "end_time": 2338.41,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 6,
    "text": "マジで",
    "start_time": 2339.15,
    "end_time": 2339.65,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "みのりちゃんであってくれてありがとう。",
    "start_time": 2339.64,
    "end_time": 2342.24,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 8,
    "text": "本当に。",
    "start_time": 2343.21,
    "end_time": 2343.71,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 9,
    "text": "いつも笑顔でいてくれてありがとう。",
    "start_time": 2344.08,
    "end_time": 2346.32,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 10,
    "text": "spそう、よろしくってなっちゃったなっていうのでこれですね。",
    "start_time": 2346.32,
    "end_time": 2351.6,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 11,
    "text": "これからもよろしく。",
    "start_time": 2346.48,
    "end_time": 2347.24,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "うん。",
    "start_time": 2350.39,
    "end_time": 2350.89,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "そう。",
    "start_time": 2351.71,
    "end_time": 2352.21,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "っていうのでこのシーン選びました。",
    "start_time": 2353.12,
    "end_time": 2355.56,
    "speaker": "Yui Ogura",
    "role": "listener_mail"
  },
  {
    "id": 15,
    "text": "うん。",
    "start_time": 2355.71,
    "end_time": 2356.21,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "最高でした。",
    "start_time": 2356.24,
    "end_time": 2356.84,
    "speaker": "Yui Ogura",
    "role": "listener_mail"
  },
  {
    "id": 17,
    "text": "みんなも",
    "start_time": 2357.09,
    "end_time": 2357.59,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "みんな感謝してくれてる。",
    "start_time": 2358.6,
    "end_time": 2359.76,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 19,
    "text": "お感謝のみんなありがとう。",
    "start_time": 2360.0,
    "end_time": 2361.92,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "してくれてる。",
    "start_time": 2362.56,
    "end_time": 2363.22,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 21,
    "text": "いや、本当そうなんだよ。",
    "start_time": 2363.22,
    "end_time": 2364.72,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 22,
    "text": "神棚立てたいぐらい、本当に。",
    "start_time": 2365.4,
    "end_time": 2367.4,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 23,
    "text": "ねえ、本当に素敵だったよね。",
    "start_time": 2367.52,
    "end_time": 2369.4,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 24,
    "text": "うん、うん。",
    "start_time": 2370.09,
    "end_time": 2370.59,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "なんかさ、今回のそのワールドリンクのお話もらって結構ももちゃん今回不穏かもみたいな噂をちょっと制作さんからね、",
    "start_time": 2371.08,
    "end_time": 2380.14,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 26,
    "text": "ちょろっと聞いてたりしてたからそう、レコーディングの時とかに実はお話ししていただいててだから実際その原稿を読むまでめちゃくちゃ不安だったの。",
    "start_time": 2380.14,
    "end_time": 2390.52,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 27,
    "text": "あ、そうだったの?",
    "start_time": 2381.96,
    "end_time": 2383.0,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "そっか、そっか。",
    "start_time": 2384.55,
    "end_time": 2385.05,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "うん。",
    "start_time": 2386.83,
    "end_time": 2387.33,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
]