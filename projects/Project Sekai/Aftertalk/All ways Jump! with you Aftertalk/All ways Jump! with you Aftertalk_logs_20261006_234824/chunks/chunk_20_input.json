[
  {
    "id": 0,
    "text": "そう、そう、そう。",
    "start_time": 1891.41,
    "end_time": 1891.91,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 1,
    "text": "すごいバランスが取れてるな。",
    "start_time": 1893.48,
    "end_time": 1894.44,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "妹とお友達してくれてありがとう。",
    "start_time": 1895.0,
    "end_time": 1897.4,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 3,
    "text": "みのりちゃん。",
    "start_time": 1898.24,
    "end_time": 1898.8,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 4,
    "text": "それで",
    "start_time": 1900.09,
    "end_time": 1900.59,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 5,
    "text": "そうだよ。",
    "start_time": 1901.54,
    "end_time": 1902.04,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 6,
    "text": "しちゃんね。",
    "start_time": 1902.04,
    "end_time": 1902.96,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 7,
    "text": "ここもなんか印象的だったよね。",
    "start_time": 1903.24,
    "end_time": 1905.36,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "同級生だから、みのりちゃん。",
    "start_time": 1905.96,
    "end_time": 1907.68,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 9,
    "text": "ええと宿題のこととか嬉しかったことの話とか。",
    "start_time": 1907.8,
    "end_time": 1911.68,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 10,
    "text": "うん。",
    "start_time": 1911.75,
    "end_time": 1912.25,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 11,
    "text": "あ、",
    "start_time": 1913.33,
    "end_time": 1914.035,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 12,
    "text": "あと、あとよくウサギさんの話をしてます。",
    "start_time": 1914.035,
    "end_time": 1916.96,
    "speaker": "3",
    "role": "listener_mail"
  },
  {
    "id": 13,
    "text": "かわいいすぎるよ。",
    "start_time": 1918.4,
    "end_time": 1919.08,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 14,
    "text": "ここがすごいね、よかった。",
    "start_time": 1919.44,
    "end_time": 1921.42,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 15,
    "text": "この兄弟だけど",
    "start_time": 1921.42,
    "end_time": 1923.44,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "そんな一面があったのね。",
    "start_time": 1924.28,
    "end_time": 1925.6,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 17,
    "text": "1年生の時にしほちゃんがちょっと一緒にお世話してるんです。",
    "start_time": 1925.88,
    "end_time": 1929.52,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 18,
    "text": "ちょっと悔しくなっちゃった、ここ。",
    "start_time": 1930.68,
    "end_time": 1932.28,
    "speaker": "Yui Ogura",
    "role": "listener_mail"
  },
  {
    "id": 19,
    "text": "あ、本当だ。",
    "start_time": 1932.4,
    "end_time": 1933.0,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "見てて。",
    "start_time": 1933.19,
    "end_time": 1933.865,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 21,
    "text": "え、私知らないよ、そんなしーちゃんって。",
    "start_time": 1933.865,
    "end_time": 1936.8,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 22,
    "text": "しーちゃん。",
    "start_time": 1938.2,
    "end_time": 1938.76,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 23,
    "text": "しークイーンだったの?",
    "start_time": 1940.12,
    "end_time": 1941.12,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 24,
    "text": "言ってよって。",
    "start_time": 1942.08,
    "end_time": 1942.76,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 25,
    "text": "うっかり見てた。",
    "start_time": 1943.2,
    "end_time": 1944.12,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 26,
    "text": "え、でもやばい。",
    "start_time": 1945.64,
    "end_time": 1946.16,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 27,
    "text": "ここはみずしずくで行かなきゃ",
    "start_time": 1946.16,
    "end_time": 1948.2,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 28,
    "text": "活動の",
    "start_time": 1948.48,
    "end_time": 1949.08,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "なんでもかんでも家族に話したりしないでしょ。",
    "start_time": 1949.24,
    "end_time": 1951.76,
    "speaker": "2",
    "role": "host"
  }
]