[
  {
    "id": 0,
    "text": "配信ご覧の皆さん、いかがでしたか?",
    "start_time": 3218.78,
    "end_time": 3221.5,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 1,
    "text": "本当コメント盛り上がっていただいて本当にありがとうございます。",
    "start_time": 3221.5,
    "end_time": 3224.48,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 2,
    "text": "本当に嬉しい、ありがとう。",
    "start_time": 3224.6,
    "end_time": 3226.2,
    "speaker": "Yui Ogura",
    "role": "listener_mail"
  },
  {
    "id": 3,
    "text": "うん。",
    "start_time": 3226.41,
    "end_time": 3226.91,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "ね、笑ってるのに切ない。",
    "start_time": 3228.04,
    "end_time": 3229.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "うん。",
    "start_time": 3229.63,
    "end_time": 3230.13,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 6,
    "text": "影がある感じもいい。",
    "start_time": 3230.72,
    "end_time": 3231.88,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 7,
    "text": "そうなんだよね、こんな表情してるももジャン。",
    "start_time": 3233.32,
    "end_time": 3235.82,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 8,
    "text": "やっぱなかなかレアというかね。",
    "start_time": 3235.82,
    "end_time": 3238.36,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 9,
    "text": "うん。",
    "start_time": 3237.67,
    "end_time": 3238.17,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "いかにこの4人が最高かっていうのを感じるね。",
    "start_time": 3239.6,
    "end_time": 3242.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "本当だね。",
    "start_time": 3242.72,
    "end_time": 3243.345,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 12,
    "text": "うん。",
    "start_time": 3243.19,
    "end_time": 3243.69,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "うん。",
    "start_time": 3243.345,
    "end_time": 3243.95,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 14,
    "text": "出会えてよかったよ。",
    "start_time": 3244.2,
    "end_time": 3245.2,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 15,
    "text": "よかった。",
    "start_time": 3245.32,
    "end_time": 3246.2,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 16,
    "text": "うん。",
