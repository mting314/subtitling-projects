[
  {
    "id": 0,
    "text": "え、肉球触ったりとか",
    "start_time": 1136.16,
    "end_time": 1137.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "肉球ももちもちするし吸うし撫でるしあ、そのサリーちゃん、サリーちゃんって言うんだっけ?",
    "start_time": 1137.72,
    "end_time": 1144.9,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 2,
    "text": "いいな。",
    "start_time": 1139.72,
    "end_time": 1140.36,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 3,
    "text": "サリーちゃんの存在もでかいし後はま、食べるし寝るし",
    "start_time": 1144.9,
    "end_time": 1151.08,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 4,
    "text": "え、やっぱ大事だね。",
    "start_time": 1151.52,
    "end_time": 1152.32,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "食べて寝る。",
    "start_time": 1152.85,
    "end_time": 1153.35,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "食べて寝るのえらい。",
    "start_time": 1154.6,
    "end_time": 1155.88,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "そうだね。",
    "start_time": 1156.4,
    "end_time": 1157.16,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "後散歩する。",
    "start_time": 1157.28,
    "end_time": 1157.88,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 9,
    "text": "あ、え、待ってわかる。",
    "start_time": 1158.28,
    "end_time": 1159.52,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "私も散歩めっちゃ好き。",
    "start_time": 1159.52,
    "end_time": 1160.76,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "すっごいリフレッシュをされるんだよね。",
    "start_time": 1161.48,
    "end_time": 1163.84,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 12,
    "text": "好きな道があって",
    "start_time": 1163.84,
    "end_time": 1165.0,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 13,
    "text": "え、あのその道をもう手ぶらで携帯も持たずに",
    "start_time": 1165.0,
    "end_time": 1170.12,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "えー。",
    "start_time": 1169.99,
    "end_time": 1170.49,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 15,
    "text": "もう本当に前だけ見てなんか空気ちゃんと吸って歩いてるとあ、",
    "start_time": 1171.2,
    "end_time": 1177.4,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 16,
    "text": "なんか呼吸してるなって思うんだよね。",
    "start_time": 1177.4,
    "end_time": 1180.44,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 17,
    "text": "うん、うん。",
    "start_time": 1180.49,
    "end_time": 1180.99,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "肩の荷が降りるじゃないけどあ、私今泉だなってなる。",
    "start_time": 1181.44,
    "end_time": 1185.68,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 19,
    "text": "自然に触れるというかわかるわ。",
    "start_time": 1185.88,
    "end_time": 1188.725,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "すごい。",
    "start_time": 1188.725,
    "end_time": 1189.23,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "1人間として生きている時間だなってなんかそのちゃんと泉鈴音ですって今みたいにこう背筋を伸ばすのも大事だけどオフになる時間を切り替えるようにしてるかな。",
    "start_time": 1189.24,
    "end_time": 1201.72,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 22,
    "text": "わかる。",
    "start_time": 1197.89,
    "end_time": 1198.39,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 23,
    "text": "確かに。",
    "start_time": 1202.0,
    "end_time": 1202.52,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 24,
    "text": "共通点結構あったね。",
    "start_time": 1202.6,
    "end_time": 1203.6,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 25,
    "text": "こうして話してみるとね。",
    "start_time": 1203.6,
    "end_time": 1205.04,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 26,
    "text": "結構皆もなんかいいねみたいな感じでね。",
    "start_time": 1205.16,
    "end_time": 1209.8,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 27,
    "text": "そう。",
    "start_time": 1209.69,
    "end_time": 1210.19,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 28,
    "text": "リフレッシュうん、うん。",
    "start_time": 1210.32,
    "end_time": 1212.08,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "猫ちゃん癒し。",
    "start_time": 1213.16,
    "end_time": 1213.68,
    "speaker": "2",
    "role": "host"
  }
]