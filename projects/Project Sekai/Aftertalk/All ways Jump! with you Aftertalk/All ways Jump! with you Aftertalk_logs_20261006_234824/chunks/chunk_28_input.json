[
  {
    "id": 0,
    "text": "確かにね。",
    "start_time": 2391.52,
    "end_time": 2392.22,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "不安なるよね。",
    "start_time": 2392.22,
    "end_time": 2392.92,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "ももちゃんもそれに結構色々あって生々しいね、描写とかも多いユニットだからさわあ、",
    "start_time": 2394.2,
    "end_time": 2400.96,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 3,
    "text": "どうなるんだろうと思ったらやっぱ最後は救いがあるというかそれもみのりちゃんがももちゃんとして活動しなくてもこう救ってくれるしあと、",
    "start_time": 2400.96,
    "end_time": 2412.72,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 4,
    "text": "うん、うん、うん。",
    "start_time": 2405.17,
    "end_time": 2405.67,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "そう、個人的にねええとエンディングか。",
    "start_time": 2412.72,
    "end_time": 2416.76,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 6,
    "text": "うん、うん、うん。",
    "start_time": 2416.83,
    "end_time": 2417.33,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "エンディングで",
    "start_time": 2417.32,
    "end_time": 2418.04,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 8,
    "text": "こう集合するじゃない。",
    "start_time": 2420.08,
    "end_time": 2422.32,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 9,
    "text": "うん、うん、うん。",
    "start_time": 2422.29,
    "end_time": 2422.79,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "ももちゃんがちゃんとみのりちゃんのオーディションをちゃんと無事通るように",
    "start_time": 2423.08,
    "end_time": 2428.2,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 11,
    "text": "うん、うん。",
    "start_time": 2423.69,
    "end_time": 2424.19,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "みんなの力添えがあってうん。",
    "start_time": 2428.32,
    "end_time": 2430.76,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "そう。",
    "start_time": 2430.11,
    "end_time": 2430.785,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 14,
    "text": "っていうシーンで、あの、屋上になんやかんや集結するのよ。",
    "start_time": 2430.785,
    "end_time": 2435.0,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 15,
    "text": "うん、うん、うん。",
    "start_time": 2435.12,
    "end_time": 2435.68,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "もうなんか嬉しくなっちゃってそこがやっぱり揃うんだって。",
    "start_time": 2435.96,
    "end_time": 2441.04,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 17,
    "text": "そうだね。",
    "start_time": 2438.24,
    "end_time": 2439.16,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "屋上いいよね。",
    "start_time": 2441.16,
    "end_time": 2442.2,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 19,
    "text": "そう。",
    "start_time": 2442.11,
    "end_time": 2442.645,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 20,
    "text": "屋上なんだよ。",
    "start_time": 2442.645,
    "end_time": 2443.88,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 21,
    "text": "うん。",
    "start_time": 2443.87,
    "end_time": 2444.37,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "っていうのも嬉しくなっちゃった。",
    "start_time": 2446.44,
    "end_time": 2447.72,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 23,
    "text": "なんかそういう風に描いてくださったのも嬉しいし今のももちゃんを知ってる私たちだからこそなんかこうしみわたるなって思ったね。",
    "start_time": 2447.72,
    "end_time": 2458.92,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 24,
    "text": "うん。",
    "start_time": 2451.29,
    "end_time": 2451.79,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "うん。",
    "start_time": 2454.93,
    "end_time": 2455.43,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 26,
    "text": "そうだね。",
    "start_time": 2457.68,
    "end_time": 2458.59,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 27,
    "text": "そう。",
    "start_time": 2458.59,
    "end_time": 2459.32,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "なんかちょっと懐かしさもあるような感じがしたし。",
    "start_time": 2459.32,
    "end_time": 2462.0,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "あ、そうだね。",
    "start_time": 2462.08,
    "end_time": 2463.04,
    "speaker": "Yui Ogura",
    "role": "host"
  }
]