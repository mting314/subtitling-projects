[
  {
    "id": 0,
    "text": "ドーナッツ食べる安心するね。",
    "start_time": 3018.08,
    "end_time": 3020.0,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "この愛莉ちゃん",
    "start_time": 3020.72,
    "end_time": 3021.44,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 2,
    "text": "可愛い。",
    "start_time": 3021.84,
    "end_time": 3022.56,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 3,
    "text": "舌出してるし。",
    "start_time": 3022.56,
    "end_time": 3023.48,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "ね。",
    "start_time": 3023.39,
    "end_time": 3023.89,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 5,
    "text": "ウインク、ペロ。",
    "start_time": 3024.12,
    "end_time": 3024.76,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "良いペロリ。",
    "start_time": 3025.08,
    "end_time": 3026.125,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 7,
    "text": "いいね。",
    "start_time": 3026.125,
    "end_time": 3026.875,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 8,
    "text": "お邪魔させていただきたくなるな、この",
    "start_time": 3026.875,
    "end_time": 3028.76,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 9,
    "text": "確かに。",
    "start_time": 3029.04,
    "end_time": 3029.56,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "ひとつ。",
    "start_time": 3030.45,
    "end_time": 3030.95,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 11,
    "text": "パーティー衣装。",
    "start_time": 3031.08,
    "end_time": 3031.68,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "ポーズも可愛いね。",
    "start_time": 3033.64,
    "end_time": 3034.68,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 13,
    "text": "こうやって頑張ってきたんだ、愛莉ちゃんも。",
    "start_time": 3035.48,
    "end_time": 3037.64,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "バラエティ。",
    "start_time": 3038.08,
    "end_time": 3038.64,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 15,
    "text": "この2人もいいね。",
    "start_time": 3040.04,
    "end_time": 3041.12,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "お弟みたいね。",
    "start_time": 3041.12,
    "end_time": 3041.96,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 17,
    "text": "うん。",
    "start_time": 3041.87,
    "end_time": 3042.37,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 18,
    "text": "ななみさんもちょこちょこね。",
    "start_time": 3043.0,
    "end_time": 3044.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 19,
    "text": "うん。",
    "start_time": 3044.71,
    "end_time": 3045.21,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 20,
    "text": "ももちゃんと一緒にやらせてもらってんだけど。",
    "start_time": 3046.44,
    "end_time": 3049.0,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "うん、うん。",
    "start_time": 3048.95,
    "end_time": 3049.45,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 22,
    "text": "またなんかできたらいいな。",
    "start_time": 3050.4,
    "end_time": 3051.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 23,
    "text": "ね。",
    "start_time": 3051.88,
    "end_time": 3052.4,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 24,
    "text": "うん。",
    "start_time": 3052.55,
    "end_time": 3053.05,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "ハッピーペロリ。",
    "start_time": 3054.28,
    "end_time": 3054.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 26,
    "text": "ハッピーペロリ。",
    "start_time": 3055.08,
    "end_time": 3055.88,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 27,
    "text": "この下の角度めっちゃ練習したって言ってた。",
    "start_time": 3056.72,
    "end_time": 3059.36,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "これも結構リアルな感じだね、よく見ると。",
    "start_time": 3059.64,
    "end_time": 3062.28,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 29,
    "text": "ももジャンイベの時そう、コメント絶対あのストーリー考えてくださる皆さん楽しんで考えてくださってんだろうな。",
    "start_time": 3062.6,
    "end_time": 3070.64,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
]