[
  {
    "id": 0,
    "text": "ここからは私たちキャストそれぞれが個人的に語りたいシーンをピックアップしております。",
    "start_time": 1242.92,
    "end_time": 1249.16,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail",
    "corner": "Story Watchalong"
  },
  {
    "id": 1,
    "text": "はい、それぞれなのでね。",
    "start_time": 1249.16,
    "end_time": 1250.725,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "うん。",
    "start_time": 1250.725,
    "end_time": 1251.395,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 3,
    "text": "はい。",
    "start_time": 1251.11,
    "end_time": 1251.61,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 4,
    "text": "4人どれ選んだかも含めて楽しんでいただけたらと思います。",
    "start_time": 1251.395,
    "end_time": 1255.08,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 5,
    "text": "はい。",
    "start_time": 1255.08,
    "end_time": 1255.69,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "まずは私がピックアップしたシーンを早速見ていただきたいと思います。",
    "start_time": 1255.69,
    "end_time": 1261.32,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 7,
    "text": "どこだろうね。",
    "start_time": 1261.4,
    "end_time": 1262.2,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 8,
    "text": "えー、では私が選んだのはこちらです。",
    "start_time": 1262.32,
    "end_time": 1265.625,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 9,
    "text": "どうぞ。",
    "start_time": 1265.625,
    "end_time": 1266.27,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "はい、こちら。",
    "start_time": 1269.52,
    "end_time": 1270.28,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "えー、遥の後編でございます。",
    "start_time": 1271.24,
    "end_time": 1273.6,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 12,
    "text": "うん。",
    "start_time": 1273.51,
    "end_time": 1274.01,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 13,
    "text": "はい。",
    "start_time": 1274.25,
    "end_time": 1274.75,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "あいついつの間にこんなたま、うわ。",
    "start_time": 1274.76,
    "end_time": 1276.76,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 15,
    "text": "やっボランティアに行ってるシーンね。",
    "start_time": 1279.6,
    "end_time": 1282.4,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 16,
    "text": "子供達と",
    "start_time": 1283.84,
    "end_time": 1284.6,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 17,
    "text": "そこまで白チームの勝ち。",
    "start_time": 1284.6,
    "end_time": 1287.72,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 18,
    "text": "勝った。",
    "start_time": 1290.11,
    "end_time": 1290.61,
    "speaker": "4",
    "role": "host"
  },
  {
    "id": 19,
    "text": "可愛い。",
    "start_time": 1291.16,
    "end_time": 1291.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "なんか子供達とのやり取りも良かったね。",
    "start_time": 1291.88,
    "end_time": 1295.2,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 21,
    "text": "輝かしいよね。",
    "start_time": 1295.4,
    "end_time": 1296.16,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "後この前編の終わりかな。",
    "start_time": 1298.72,
    "end_time": 1300.44,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 23,
    "text": "みのりちゃんドッジボール読んでくれて",
    "start_time": 1300.92,
    "end_time": 1302.76,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 24,
    "text": "みのりちゃんの恋大戦に気づいてどうしたのって声かけてるシーンとかもすごい印象深かったな。",
    "start_time": 1303.4,
    "end_time": 1309.36,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 25,
    "text": "あのね",
    "start_time": 1310.77,
    "end_time": 1311.27,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 26,
    "text": "良さがすごい気になったけど",
    "start_time": 1311.76,
    "end_time": 1314.52,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 27,
    "text": "そう、そう、そう。",
    "start_time": 1313.17,
    "end_time": 1313.67,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "みゆきちゃんが着てるTシャツは作品だよねって言って歌歌ってあげたりして。",
    "start_time": 1315.48,
    "end_time": 1320.68,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "そう、そう、そう。",
    "start_time": 1320.71,
    "end_time": 1321.21,
    "speaker": "2",
    "role": "host"
  }
]