[
  {
    "id": 0,
    "text": "ありのままの私じゃ周りを失望させるだけだって思ってたけど。",
    "start_time": 2119.16,
    "end_time": 2124.52,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 1,
    "text": "うん、うん。",
    "start_time": 2124.41,
    "end_time": 2124.91,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 2,
    "text": "こんな風に受け入れてくれる子もいるのね。",
    "start_time": 2124.52,
    "end_time": 2128.56,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 3,
    "text": "なんかこの",
    "start_time": 2126.0,
    "end_time": 2126.8,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 4,
    "text": "みのりのお言葉をもらう会みたいなのやったらさすごい励まされる人めちゃくちゃいそうじゃない?",
    "start_time": 2128.72,
    "end_time": 2133.72,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 5,
    "text": "それ個人的に行きたいかも。",
    "start_time": 2133.84,
    "end_time": 2135.0,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "浴びたい。",
    "start_time": 2136.44,
    "end_time": 2136.96,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 7,
    "text": "そうだよね。",
    "start_time": 2137.09,
    "end_time": 2137.59,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "あの言葉。",
    "start_time": 2138.09,
    "end_time": 2138.59,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 9,
    "text": "ちょっとやってほしいわ。",
    "start_time": 2138.68,
    "end_time": 2139.68,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "自分の悩みとか聞いてほしい。",
    "start_time": 2139.8,
    "end_time": 2141.64,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 11,
    "text": "うん。",
    "start_time": 2141.77,
    "end_time": 2142.27,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "なんか絶対いいよね。",
    "start_time": 2142.36,
    "end_time": 2143.52,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 13,
    "text": "うん。",
    "start_time": 2143.53,
    "end_time": 2144.03,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "心が軽くなると。",
    "start_time": 2145.4,
    "end_time": 2146.44,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 15,
    "text": "みんなのひなもりしずくでいたいから。",
    "start_time": 2146.6,
    "end_time": 2148.04,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "いいな、それ。",
    "start_time": 2148.2,
    "end_time": 2148.92,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 17,
    "text": "うん。",
    "start_time": 2148.77,
    "end_time": 2149.27,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "そうなんですか?",
    "start_time": 2150.04,
    "end_time": 2150.68,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 19,
    "text": "そのくらいパワーがあるね。",
    "start_time": 2151.12,
    "end_time": 2152.28,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 20,
    "text": "うん、うん。",
    "start_time": 2152.33,
    "end_time": 2152.83,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "とても素敵だなって思いますけど。",
    "start_time": 2153.0,
    "end_time": 2155.0,
    "speaker": "3",
    "role": "host"
  },
  {
    "id": 22,
    "text": "うん。",
    "start_time": 2155.37,
    "end_time": 2155.87,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 23,
    "text": "先輩がそう言うなら分かりました。",
    "start_time": 2156.0,
    "end_time": 2158.28,
    "speaker": "3",
    "role": "listener_mail"
  },
  {
    "id": 24,
    "text": "ここも優しいんだよ。",
    "start_time": 2158.52,
    "end_time": 2159.4,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "本当にいい子だなと思って。",
    "start_time": 2159.64,
    "end_time": 2161.64,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 26,
    "text": "ね。",
    "start_time": 2161.97,
    "end_time": 2162.47,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 27,
    "text": "みのりちゃん。",
    "start_time": 2162.52,
    "end_time": 2163.08,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 28,
    "text": "そうだよね。",
    "start_time": 2163.77,
    "end_time": 2164.27,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "本当に。",
    "start_time": 2164.75,
    "end_time": 2165.25,
    "speaker": "Yui Ogura",
    "role": "host"
  }
]