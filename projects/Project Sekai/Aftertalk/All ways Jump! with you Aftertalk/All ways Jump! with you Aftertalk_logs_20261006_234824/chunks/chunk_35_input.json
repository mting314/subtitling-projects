[
  {
    "id": 0,
    "text": "うん。",
    "start_time": 2839.83,
    "end_time": 2840.33,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 1,
    "text": "本当に。",
    "start_time": 2841.04,
    "end_time": 2841.68,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 2,
    "text": "この光と影ってところも",
    "start_time": 2842.68,
    "end_time": 2844.76,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 3,
    "text": "ここ結構うん。",
    "start_time": 2844.76,
    "end_time": 2846.12,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "パキッてこううん。",
    "start_time": 2846.52,
    "end_time": 2847.64,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 5,
    "text": "しっかり分かれているけども。",
    "start_time": 2847.84,
    "end_time": 2849.64,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "部屋の窓から光が差してる角度。",
    "start_time": 2850.44,
    "end_time": 2853.42,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "そしてこの左奥に布がかかってるマネキンがアスランの衣装なのかな。",
    "start_time": 2853.42,
    "end_time": 2860.52,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "うん。",
    "start_time": 2854.75,
    "end_time": 2855.25,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 9,
    "text": "うん、うん。",
    "start_time": 2858.01,
    "end_time": 2858.51,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 10,
    "text": "これいいね。",
    "start_time": 2861.68,
    "end_time": 2862.56,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 11,
    "text": "コメント見てからこう見るとすごく、あ、なるほどっていううん。",
    "start_time": 2862.56,
    "end_time": 2868.76,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 12,
    "text": "うん。",
    "start_time": 2863.67,
    "end_time": 2864.17,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "すごく伝わるね。",
    "start_time": 2867.56,
    "end_time": 2868.44,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "発見もあるし。",
    "start_time": 2868.76,
    "end_time": 2869.56,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 15,
    "text": "美しいね、あと。",
    "start_time": 2870.2,
    "end_time": 2871.3,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 16,
    "text": "こんなこう、うつ、なんかうつろげな感じなのに",
    "start_time": 2871.3,
    "end_time": 2874.4,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 17,
    "text": "美しいよ。",
    "start_time": 2874.76,
    "end_time": 2875.36,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "この儚いはるかちゃんもいいね、素敵よね。",
    "start_time": 2876.48,
    "end_time": 2879.32,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 19,
    "text": "素敵よね。",
    "start_time": 2878.03,
    "end_time": 2878.53,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "うん。",
    "start_time": 2879.19,
    "end_time": 2879.905,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "もう確かにこう諦めたくないっていう気持ちがこう目のうつろげな目にもちゃんと現れてるな。",
    "start_time": 2879.905,
    "end_time": 2886.88,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "ね、光で表現されてて。",
    "start_time": 2886.96,
    "end_time": 2889.24,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 23,
    "text": "うん、うん、うん。",
    "start_time": 2889.49,
    "end_time": 2889.99,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 24,
    "text": "素敵だね。",
    "start_time": 2891.12,
    "end_time": 2891.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "うん。",
    "start_time": 2891.59,
    "end_time": 2892.09,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 26,
    "text": "ありがとうございます。",
    "start_time": 2892.84,
    "end_time": 2893.36,
    "speaker": "Yui Ogura",
    "role": "listener_mail"
  },
  {
    "id": 27,
    "text": "衣装も可愛いね。",
    "start_time": 2893.48,
    "end_time": 2894.2,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "これ可愛いよね、この衣装。",
    "start_time": 2894.36,
    "end_time": 2895.92,
    "speaker": "Yui Ogura",
    "role": "host"
  },
  {
    "id": 29,
    "text": "すごい可愛い。",
    "start_time": 2895.92,
    "end_time": 2897.0,
    "speaker": "Yui Ogura",
    "role": "host"
  }
]