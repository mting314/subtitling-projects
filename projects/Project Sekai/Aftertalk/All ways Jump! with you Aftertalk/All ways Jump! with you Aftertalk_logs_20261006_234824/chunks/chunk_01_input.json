[
  {
    "id": 0,
    "text": "せーのプロセカアフタートークアフタートークwithyou編",
    "start_time": 596.0,
    "end_time": 603.24,
    "speaker": "Yui Ogura"
  },
  {
    "id": 1,
    "text": "はい、皆さん日こんばんは。",
    "start_time": 606.36,
    "end_time": 608.2,
    "speaker": "Rina Honnizumi"
  },
  {
    "id": 2,
    "text": "ももジャンプ留役の小倉唯と",
    "start_time": 608.72,
    "end_time": 611.36,
    "speaker": "Rina Honnizumi"
  },
  {
    "id": 3,
    "text": "はい、日野守雫役泉鈴音です。",
    "start_time": 611.68,
    "end_time": 614.92,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 4,
    "text": "お願いします。",
    "start_time": 614.92,
    "end_time": 615.68,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 5,
    "text": "お願いします。",
    "start_time": 615.8,
    "end_time": 617.08,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 6,
    "text": "え、このプロセカアフタートークは皆さんからいただいたおたよりを紹介しながらイベントを振り返る番組となっております。",
    "start_time": 617.84,
    "end_time": 625.7,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail",
    "corner": "Fan Letter Corner"
  },
  {
    "id": 7,
    "text": "今回はアフタートークwithyou編となっていまして皆さんストーリーはお楽しみいただけましたでしょうか?",
    "start_time": 625.7,
    "end_time": 633.32,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 8,
    "text": "皆さんどうですか?",
    "start_time": 633.4,
    "end_time": 634.52,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 9,
    "text": "どうですかね?",
    "start_time": 634.64,
    "end_time": 635.2,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "コメントあ、こんばんは皆言ってる。",
    "start_time": 635.36,
    "end_time": 638.21,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 11,
    "text": "うん。",
    "start_time": 635.97,
    "end_time": 636.47,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "本当?",
    "start_time": 638.21,
    "end_time": 638.8,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 13,
    "text": "こんばんは。",
    "start_time": 638.8,
    "end_time": 639.6,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 14,
    "text": "こんばんは。",
    "start_time": 639.61,
    "end_time": 640.11,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 15,
    "text": "うん、うん。",
    "start_time": 641.97,
    "end_time": 642.47,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "ほんちゃん",
    "start_time": 643.57,
    "end_time": 644.07,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 17,
    "text": "ほんちゃん、ほんちゃん。",
    "start_time": 644.36,
    "end_time": 645.16,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 18,
    "text": "ほんちゃんです。",
    "start_time": 645.92,
    "end_time": 646.68,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 19,
    "text": "ストーリー泣きました。",
    "start_time": 647.36,
    "end_time": 648.5,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 20,
    "text": "ね、皆多分それぞれ感想あると思うんですがこの後も2人でしっかり触れていこうと思うんだけどね。",
    "start_time": 648.5,
    "end_time": 656.76,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 21,
    "text": "うん、うん。",
    "start_time": 651.08,
    "end_time": 651.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "ちょっと感情揺さぶられるシーンがね。",
    "start_time": 657.48,
    "end_time": 659.72,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 23,
    "text": "なんかねこういつもと違う世界というかね。",
    "start_time": 660.04,
    "end_time": 664.2,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 24,
    "text": "うん。",
    "start_time": 664.39,
    "end_time": 664.89,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 25,
    "text": "新鮮なストーリーでしたね。",
    "start_time": 665.0,
    "end_time": 667.04,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 26,
    "text": "ねえ。",
    "start_time": 667.32,
    "end_time": 667.84,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 27,
    "text": "うん、うん。",
    "start_time": 667.77,
    "end_time": 668.27,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "後で深掘りしていこう。",
    "start_time": 668.4,
    "end_time": 670.12,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 29,
    "text": "うん、うん。",
    "start_time": 670.24,
    "end_time": 670.96,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
