[
  {
    "id": 0,
    "text": "そして4月からあ、違うや。",
    "start_time": 671.76,
    "end_time": 674.86,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "えーと今回はん?",
    "start_time": 674.86,
    "end_time": 676.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "えー合ってる。",
    "start_time": 677.96,
    "end_time": 678.82,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 3,
    "text": "今回はワールドリンクイベント2周目。",
    "start_time": 678.82,
    "end_time": 681.815,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 4,
    "text": "うん。",
    "start_time": 681.815,
    "end_time": 682.505,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 5,
    "text": "2周目だったんだね。",
    "start_time": 682.505,
    "end_time": 683.8,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 6,
    "text": "そっか、そっか。",
    "start_time": 683.88,
    "end_time": 684.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "2周のとはまた違った雰囲気だねって話を後でしようと思います。",
    "start_time": 684.72,
    "end_time": 689.8,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 8,
    "text": "皆も続々と感想をいただいてありがとうございます。",
    "start_time": 690.0,
    "end_time": 692.52,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 9,
    "text": "ね、ありがとうございます。",
    "start_time": 692.64,
    "end_time": 693.92,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 10,
    "text": "たくさん。",
    "start_time": 693.92,
    "end_time": 694.68,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 11,
    "text": "うん。",
    "start_time": 694.63,
    "end_time": 695.13,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "そして4月からアフタートークがプチリニューアルし事前にプロセカ公式Discordとメールにてアフタートークへのおたよりを募集していました。",
    "start_time": 695.36,
    "end_time": 706.16,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 13,
    "text": "皆さんおたより本当にありがとうございます。",
    "start_time": 706.16,
    "end_time": 708.8,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 14,
    "text": "ありがとうございます。",
    "start_time": 708.92,
    "end_time": 709.44,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 15,
    "text": "いただいたおたよりを番組内で紹介させていただきますのでお楽しみに。",
    "start_time": 709.76,
    "end_time": 714.6,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 16,
    "text": "うん。",
    "start_time": 714.26,
    "end_time": 714.76,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 17,
    "text": "お願いします。",
    "start_time": 714.76,
    "end_time": 715.76,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 18,
    "text": "お願いします。",
    "start_time": 715.85,
    "end_time": 716.35,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 19,
    "text": "またこのイベントや、え、この放送の感想をプロセカアフタートークハッシュタグつけて投稿してください。",
    "start_time": 716.4,
    "end_time": 724.2,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 20,
    "text": "え、YouTubeのチャットもね、こちら私たちも見れておりますので、え、",
    "start_time": 724.2,
    "end_time": 728.12,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 21,
    "text": "気になるコメントもどんどんと拾っていきたいと思います。",
    "start_time": 728.12,
    "end_time": 731.28,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 22,
    "text": "拾っていきますよ。",
    "start_time": 731.4,
    "end_time": 732.2,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 23,
    "text": "皆すごいありがとうございます。",
    "start_time": 732.2,
    "end_time": 733.68,
    "speaker": "2",
    "role": "listener_mail"
  },
  {
    "id": 24,
    "text": "どんどんどんどん",
    "start_time": 734.52,
    "end_time": 735.2,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 25,
    "text": "2人だとふわふわふんわりしてる。",
    "start_time": 735.4,
    "end_time": 737.48,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 26,
    "text": "ふんわりしてる。",
    "start_time": 738.44,
    "end_time": 738.96,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 27,
    "text": "天然コンビでもあるからね。",
    "start_time": 741.08,
    "end_time": 742.48,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "え、天然コンビなの?",
    "start_time": 742.6,
    "end_time": 743.56,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 29,
    "text": "ももちゃんの中では",
    "start_time": 743.84,
    "end_time": 744.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
]