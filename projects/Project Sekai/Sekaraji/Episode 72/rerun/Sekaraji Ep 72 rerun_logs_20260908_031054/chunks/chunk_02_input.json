[
  {
    "id": 0,
    "text": "リアルお姉ちゃん?",
    "start_time": 69.6,
    "end_time": 70.48,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "リアルお姉ちゃんです。",
    "start_time": 70.6,
    "end_time": 71.62,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 2,
    "text": "2人姉妹。",
    "start_time": 71.62,
    "end_time": 72.62,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 3,
    "text": "2人姉妹で、そう。",
    "start_time": 72.62,
    "end_time": 74.04,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 4,
    "text": "え?",
    "start_time": 74.05,
    "end_time": 74.775,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "ど、どうっか?",
    "start_time": 74.775,
    "end_time": 75.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "めっちゃ1人っ子。",
    "start_time": 75.76,
    "end_time": 76.68,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 7,
    "text": "あ、そうなんだ。",
    "start_time": 76.73,
    "end_time": 77.23,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "そっか。",
    "start_time": 78.36,
    "end_time": 79.08,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 9,
    "text": "うん。",
    "start_time": 79.03,
    "end_time": 79.53,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 10,
    "text": "でもなんか雫さんっぽいからいるもんだと思っていた。",
    "start_time": 79.68,
    "end_time": 83.52,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "お姉ちゃん?",
    "start_time": 83.68,
    "end_time": 84.35,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 12,
    "text": "お姉ちゃん。",
    "start_time": 84.33,
    "end_time": 84.83,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "え?",
    "start_time": 84.35,
    "end_time": 84.96,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 14,
    "text": "マジ?",
    "start_time": 84.96,
    "end_time": 85.46,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 15,
    "text": "そう、でも雫ちゃんと同じで妹ちゃんがもうお姉ちゃんかな。",
    "start_time": 85.56,
    "end_time": 88.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "ってやってそうって勝手に思ってた。",
    "start_time": 88.84,
    "end_time": 90.84,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 17,
    "text": "そんな気がする私も。",
    "start_time": 91.56,
    "end_time": 92.8,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "ああ。",
    "start_time": 92.77,
    "end_time": 93.27,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 19,
    "text": "めっちゃ頼っちゃうかも、兄弟だから。",
    "start_time": 93.4,
    "end_time": 95.41,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "そっか。",
    "start_time": 95.13,
    "end_time": 95.63,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 21,
    "text": "え?",
    "start_time": 95.41,
    "end_time": 96.08,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "でもお姉さん役とか多そう、役。",
    "start_time": 96.08,
    "end_time": 98.24,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 23,
    "text": "そうだね、どっちかっていうと本当にお姉さんは本当に多い。",
    "start_time": 98.76,
    "end_time": 102.14,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 24,
    "text": "ありがたいことに。",
    "start_time": 102.14,
    "end_time": 102.84,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 25,
    "text": "あ、嬉しいでございます。",
    "start_time": 103.36,
    "end_time": 104.52,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 26,
    "text": "ありがとうございます。",
    "start_time": 105.08,
    "end_time": 105.8,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 27,
    "text": "え、ということでこれは8月の28日配信されているらしい。",
    "start_time": 107.24,
    "end_time": 112.24,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 28,
    "text": "もう早いとこだと学校も始まってるらしいっていうところで。",
    "start_time": 112.24,
    "end_time": 117.08,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 29,
    "text": "びっくりですよ。",
    "start_time": 117.2,
    "end_time": 118.42,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
]