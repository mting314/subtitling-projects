[
  {
    "id": 0,
    "text": "皆",
    "start_time": 0.0,
    "end_time": 1.0,
    "speaker": "Rina Honnizumi",
    "role": "host",
    "corner": "Opening Talk"
  },
  {
    "id": 1,
    "text": "さんこんばんは。",
    "start_time": 5.08,
    "end_time": 6.16,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "ももジャンプ日野守滴役の本泉莉奈です。",
    "start_time": 6.16,
    "end_time": 9.56,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 3,
    "text": "皆さんこんばんは。",
    "start_time": 10.04,
    "end_time": 11.18,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 4,
    "text": "25時25時ナイトコードで暁絵名役の鈴木みのりです。",
    "start_time": 11.18,
    "end_time": 14.72,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 5,
    "text": "はい。",
    "start_time": 14.72,
    "end_time": 15.4,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "はい。",
    "start_time": 15.39,
    "end_time": 15.89,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 7,
    "text": "スマートフォンゲームプロジェクトセカイカラフルステージfeat.",
    "start_time": 15.92,
    "end_time": 19.66,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "初音ミクのキャストがお届けするラジオ番組セカラジ。",
    "start_time": 19.66,
    "end_time": 23.88,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 9,
    "text": "今回はこの2人でお届けします。",
    "start_time": 23.88,
    "end_time": 26.28,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "お姉ちゃんです。",
    "start_time": 27.04,
    "end_time": 28.36,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "え?",
    "start_time": 28.16,
    "end_time": 28.66,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 12,
    "text": "お姉ちゃん",
    "start_time": 28.66,
    "end_time": 29.16,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 13,
    "text": "お姉ちゃん同士って確かに揃ったことなかった気がするね、今まで。",
    "start_time": 29.0,
    "end_time": 33.56,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "なんか勝手にこの台本にお姉ちゃんな2人って書いてあるんですけど、",
    "start_time": 33.72,
    "end_time": 37.76,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 15,
    "text": "なんかただ仲いいから呼ばれたのかなって思って、あの、",
    "start_time": 37.76,
    "end_time": 41.08,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 16,
    "text": "絵名と、そう、雫ちゃんが仲いいからかしらと思ったらお姉ちゃんでした。",
    "start_time": 41.08,
    "end_time": 46.16,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 17,
    "text": "すごい、そういえばそうだって私もうん。",
    "start_time": 46.72,
    "end_time": 49.32,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "ね、なんかたまに2人ともどっちがお姉ちゃんかわかんなくなる、お姉ちゃんっていうかね、",
    "start_time": 49.4,
    "end_time": 54.12,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 19,
    "text": "どっちが上かわかんなくなる関係性ですけど。",
    "start_time": 54.12,
    "end_time": 57.215,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 20,
    "text": "確かに。",
    "start_time": 57.05,
    "end_time": 57.61,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "ね。",
    "start_time": 57.215,
    "end_time": 58.145,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 22,
    "text": "うん。",
    "start_time": 57.61,
    "end_time": 58.17,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 23,
    "text": "そう、今日は2人でお届けしていきたいと思います。",
    "start_time": 58.145,
    "end_time": 61.32,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 24,
    "text": "ちなみに鈴川ちゃんはさ、兄弟っています?",
    "start_time": 61.44,
    "end_time": 64.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "あ!",
    "start_time": 64.73,
    "end_time": 65.395,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 26,
    "text": "お姉ちゃんです。",
    "start_time": 65.395,
    "end_time": 66.28,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 27,
    "text": "え?",
    "start_time": 66.16,
    "end_time": 66.66,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "そうなの?",
    "start_time": 66.66,
    "end_time": 67.19,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "妹がいてそう。",
    "start_time": 67.36,
    "end_time": 69.24,
    "speaker": "Minori Suzuki",
    "role": "host"
  }
]