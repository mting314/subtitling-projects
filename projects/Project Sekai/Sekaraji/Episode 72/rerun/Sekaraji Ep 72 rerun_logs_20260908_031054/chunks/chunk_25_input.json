[
  {
    "id": 0,
    "text": "何の曲歌うんだろう?",
    "start_time": 1631.54,
    "end_time": 1632.96,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "ね、楽しみにしててください。",
    "start_time": 1633.2,
    "end_time": 1635.52,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 2,
    "text": "2号も4人揃うんだよね、今年。",
    "start_time": 1635.76,
    "end_time": 1637.845,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 3,
    "text": "うれしう。",
    "start_time": 1637.845,
    "end_time": 1638.35,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "去年初めて、あ、まシンフォニーでは揃ってたけど去年感謝祭では初めて揃ってでもやっぱりなんかこう、",
    "start_time": 1638.72,
    "end_time": 1646.98,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 5,
    "text": "うん。",
    "start_time": 1641.83,
    "end_time": 1642.33,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "うん。",
    "start_time": 1644.47,
    "end_time": 1644.97,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "なんだろう、3人で歌ってたりとか2人で歌ってたりするのもちろん楽しいけど、",
    "start_time": 1646.98,
    "end_time": 1653.04,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 8,
    "text": "なんかもともとの歌いわけでちゃんとこうなんだろう、4人で揃うとか、",
    "start_time": 1653.04,
    "end_time": 1659.48,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 9,
    "text": "うん。",
    "start_time": 1658.71,
    "end_time": 1659.21,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "あ、やっぱり4人で1つのユニットなんだってなんか自分で改めて確認できるっていうかなんかピースがはまる感じ。",
    "start_time": 1659.48,
    "end_time": 1668.16,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 11,
    "text": "うん。",
    "start_time": 1665.43,
    "end_time": 1665.93,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "あ、なんかピチッとね。",
    "start_time": 1668.28,
    "end_time": 1669.28,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "やっとエナがエナになるというかなんかそんな感じがすごく去年したんで。",
    "start_time": 1669.6,
    "end_time": 1675.12,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 14,
    "text": "うん。",
    "start_time": 1671.85,
    "end_time": 1672.35,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 15,
    "text": "はあ。",
    "start_time": 1675.01,
    "end_time": 1675.51,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "ねえ。",
    "start_time": 1675.85,
    "end_time": 1676.555,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 17,
    "text": "そっか。",
    "start_time": 1676.27,
    "end_time": 1676.77,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "モモジャンもきっとシンフォニーも揃っててちょっと踊ってくれてたけどありがとうございます。",
    "start_time": 1676.555,
    "end_time": 1683.16,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 19,
    "text": "うん。",
    "start_time": 1678.07,
    "end_time": 1678.57,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "よりもっと",
    "start_time": 1681.52,
    "end_time": 1682.28,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "きっとね。",
    "start_time": 1684.33,
    "end_time": 1684.83,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "頑張る。",
    "start_time": 1685.02,
    "end_time": 1685.52,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 23,
    "text": "うん、楽しみ。",
    "start_time": 1685.52,
    "end_time": 1686.8,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 24,
    "text": "ねえ、楽しみ。",
    "start_time": 1687.08,
    "end_time": 1687.88,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "楽しみにお願いします。",
    "start_time": 1688.08,
    "end_time": 1689.08,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 26,
    "text": "今年も。",
    "start_time": 1689.08,
    "end_time": 1689.68,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 27,
    "text": "楽しみにします。",
    "start_time": 1689.84,
    "end_time": 1690.48,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "じゃあ、続いて行きましょうかね。",
    "start_time": 1690.6,
    "end_time": 1693.16,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 29,
    "text": "はい。",
    "start_time": 1691.31,
    "end_time": 1691.81,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
]