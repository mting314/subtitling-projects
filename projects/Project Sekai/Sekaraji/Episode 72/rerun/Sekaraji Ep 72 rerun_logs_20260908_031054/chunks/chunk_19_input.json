[
  {
    "id": 0,
    "text": "ということで、ここで1曲お届けします。",
    "start_time": 1105.64,
    "end_time": 1108.28,
    "speaker": "Minori Suzuki",
    "role": "host",
    "corner": "Song"
  },
  {
    "id": 1,
    "text": "うん。",
    "start_time": 1108.25,
    "end_time": 1108.75,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "え、この曲はですね雫がメインの曲でもあるんですけれどこう聞いていただきながら心の空模様がどんどん変化していくのを一緒に寄り添ってもらえたら嬉しいなって思っております。",
    "start_time": 1109.32,
    "end_time": 1125.92,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 3,
    "text": "はい。",
    "start_time": 1111.41,
    "end_time": 1111.91,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "うん。",
    "start_time": 1114.97,
    "end_time": 1115.47,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "それでは",
    "start_time": 1126.49,
    "end_time": 1126.99,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 6,
    "text": "ちっ。",
    "start_time": 1265.79,
    "end_time": 1266.29,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "今回はこんなテーマでメールを募集しました。",
    "start_time": 1271.0,
    "end_time": 1274.16,
    "speaker": "Minori Suzuki",
    "role": "host",
    "corner": "Theme Mail"
  },
  {
    "id": 8,
    "text": "秋に楽しみなこと。",
    "start_time": 1274.92,
    "end_time": 1277.04,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 9,
    "text": "accelerated",
    "start_time": 1276.6,
    "end_time": 1277.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "平和。",
    "start_time": 1279.12,
    "end_time": 1279.68,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "平和。",
    "start_time": 1279.83,
    "end_time": 1280.33,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 12,
    "text": "平和。",
    "start_time": 1280.37,
    "end_time": 1280.87,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "まだ残暑は続きますが、もう少ししたら秋もやってくるということで、",
    "start_time": 1281.52,
    "end_time": 1286.2,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 14,
    "text": "今回は皆さんから秋に楽しみなことを募集しました。",
    "start_time": 1286.2,
    "end_time": 1290.56,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 15,
    "text": "じゃあ早速メールを紹介していきます。",
    "start_time": 1290.56,
    "end_time": 1293.2,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 16,
    "text": "はい。",
    "start_time": 1293.32,
    "end_time": 1293.92,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 17,
    "text": "えー。",
    "start_time": 1294.41,
    "end_time": 1294.91,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 18,
    "text": "あ。",
    "start_time": 1294.71,
    "end_time": 1295.21,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 19,
    "text": "揚げたてのポテトさんです。",
    "start_time": 1296.12,
    "end_time": 1297.72,
    "speaker": "Minori Suzuki",
    "role": "host_meta"
  },
  {
    "id": 20,
    "text": "ありがとうございます。",
    "start_time": 1297.72,
    "end_time": 1298.84,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 21,
    "text": "すいません。",
    "start_time": 1298.85,
    "end_time": 1299.35,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "ほんいずみさん、すずきさん、こんばんは。",
    "start_time": 1300.96,
    "end_time": 1303.2,
    "speaker": "Minori Suzuki",
    "role": "listener_mail"
  },
  {
    "id": 23,
    "text": "こんばんは。",
    "start_time": 1303.32,
    "end_time": 1303.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 24,
    "text": "僕の秋に楽しみなことはもみじです。",
    "start_time": 1304.04,
    "end_time": 1307.0,
    "speaker": "Minori Suzuki",
    "role": "listener_mail"
  },
  {
    "id": 25,
    "text": "紅葉です。",
    "start_time": 1307.56,
    "end_time": 1308.16,
    "speaker": "Minori Suzuki",
    "role": "listener_mail"
  },
  {
    "id": 26,
    "text": "9月に京都に紅葉を見に行きます。",
    "start_time": 1308.92,
    "end_time": 1311.64,
    "speaker": "Minori Suzuki",
    "role": "listener_mail"
  },
  {
    "id": 27,
    "text": "京都には夏に行くことが多く、秋に行くのは初めてで清水寺などの紅葉の写真などを見て、",
    "start_time": 1311.64,
    "end_time": 1319.3,
    "speaker": "Minori Suzuki",
    "role": "listener_mail"
  },
  {
    "id": 28,
    "text": "綺麗だなと思ってたので、見に行くのが今から楽しみです。",
    "start_time": 1319.3,
    "end_time": 1323.78,
    "speaker": "Minori Suzuki",
    "role": "listener_mail"
  },
  {
    "id": 29,
    "text": "あら。",
    "start_time": 1323.61,
    "end_time": 1324.11,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
]