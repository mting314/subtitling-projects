[
  {
    "id": 0,
    "text": "ねえ、もっと華やかなのか。",
    "start_time": 2053.24,
    "end_time": 2054.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "やりたい放題っていうか、なんて言うか、あの",
    "start_time": 2054.84,
    "end_time": 2056.64,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "ということがね、そうあっだね。",
    "start_time": 2055.9,
    "end_time": 2057.08,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 3,
    "text": "て。 高校やっぱ油断としかちゃだめ中学だね。",
    "start_time": 2057.08,
    "end_time": 2058.48,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 4,
    "text": "に比べたらほっとしちゃう。",
    "start_time": 2058.48,
    "end_time": 2059.72,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 5,
    "text": "そうだね。",
    "start_time": 2058.59,
    "end_time": 2059.245,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "ああ、自分たちでね。",
    "start_time": 2059.245,
    "end_time": 2060.92,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "終わると。",
    "start_time": 2059.72,
    "end_time": 2060.37,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 8,
    "text": "私も実家あれも帰っあるたもん時ね。",
    "start_time": 2060.37,
    "end_time": 2061.88,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 9,
    "text": "そのに財布声優忘れさんを呼んてでトークショーして愛知くれまでたりする大学の行き帰りさんもあるから。",
    "start_time": 2061.88,
    "end_time": 2066.16,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 10,
    "text": "あ、ドッキドキしちゃう。",
    "start_time": 2063.32,
    "end_time": 2064.24,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "そういうこと財布もできるなしで。",
    "start_time": 2066.16,
    "end_time": 2067.43,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 12,
    "text": "確かに。",
    "start_time": 2067.31,
    "end_time": 2067.81,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "でも、から。",
    "start_time": 2067.43,
    "end_time": 2068.08,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 14,
    "text": "あの、より何自分ですたちか?",
    "start_time": 2068.08,
    "end_time": 2069.28,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 15,
    "text": "うん。",
    "start_time": 2069.1,
    "end_time": 2069.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "であの、いろいろ携帯やれるから。",
    "start_time": 2069.28,
    "end_time": 2071.0,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 17,
    "text": "うん。",
    "start_time": 2069.6,
    "end_time": 2070.1,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "の支払いで楽しんでね。",
    "start_time": 2071.0,
    "end_time": 2072.86,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 19,
    "text": "ああ。",
    "start_time": 2071.25,
    "end_time": 2071.975,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "あ、そうだよね。",
    "start_time": 2071.975,
    "end_time": 2072.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "ねえ、楽しんでください。",
    "start_time": 2072.84,
    "end_time": 2074.36,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "行けたし、チケットもクレジット素敵でや。",
    "start_time": 2072.86,
    "end_time": 2074.72,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 23,
    "text": "事前にネットはい。",
    "start_time": 2074.72,
    "end_time": 2075.48,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 24,
    "text": "で買ってたから行けちゃっはい。",
    "start_time": 2075.48,
    "end_time": 2076.8,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 25,
    "text": "たけどそれもえ、ヒヤッということとしで、たな。",
    "start_time": 2076.8,
    "end_time": 2078.84,
    "speaker": "Minori Suzuki",
    "role": "host"
  }
]