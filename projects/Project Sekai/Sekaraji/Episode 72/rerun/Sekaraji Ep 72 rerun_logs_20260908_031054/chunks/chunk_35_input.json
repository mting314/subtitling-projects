[
  {
    "id": 0,
    "text": "ということであっという間でしたけれども今回ここでお別れです。",
    "start_time": 2108.36,
    "end_time": 2114.6,
    "speaker": "Minori Suzuki",
    "role": "host",
    "corner": "Ending"
  },
  {
    "id": 1,
    "text": "はい。",
    "start_time": 2110.55,
    "end_time": 2111.05,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "はい。",
    "start_time": 2111.91,
    "end_time": 2112.41,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 3,
    "text": "うん。",
    "start_time": 2113.31,
    "end_time": 2113.81,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "お別れです。",
    "start_time": 2114.72,
    "end_time": 2115.24,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "また感謝祭かファンミーティングで会いましょうになるかな?",
    "start_time": 2116.2,
    "end_time": 2119.84,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 6,
    "text": "そうだね。",
    "start_time": 2118.37,
    "end_time": 2118.87,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "なんかお姉ちゃんらしいトークできなかったかな、あんまり。",
    "start_time": 2120.0,
    "end_time": 2122.52,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "忘れ物してるし。",
    "start_time": 2123.16,
    "end_time": 2124.2,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 9,
    "text": "今思えば。",
    "start_time": 2124.4,
    "end_time": 2124.96,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "思えば。",
    "start_time": 2125.12,
    "end_time": 2125.66,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 11,
    "text": "お姉ちゃんらしいって何なんだろうね。",
    "start_time": 2125.66,
    "end_time": 2127.72,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 12,
    "text": "ああ、そ、ああ、そうね。",
    "start_time": 2127.96,
    "end_time": 2129.56,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "ねえ。",
    "start_time": 2129.57,
    "end_time": 2130.07,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 14,
    "text": "その定義から始まっちゃうよね。",
    "start_time": 2130.08,
    "end_time": 2132.12,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 15,
    "text": "始まっちゃうよね。",
    "start_time": 2132.23,
    "end_time": 2132.785,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 16,
    "text": "本当1時間必要だね。",
    "start_time": 2132.785,
    "end_time": 2134.28,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 17,
    "text": "紅葉にちゃんがいてもいいじゃない。",
    "start_time": 2134.44,
    "end_time": 2136.16,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "いいじゃない。",
    "start_time": 2136.18,
    "end_time": 2136.68,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 19,
    "text": "そうだよ。",
    "start_time": 2136.68,
    "end_time": 2137.18,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 20,
    "text": "うん。",
    "start_time": 2137.09,
    "end_time": 2137.59,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "ありがとうございました。",
    "start_time": 2138.08,
    "end_time": 2138.76,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 22,
    "text": "ありがとうございます。",
    "start_time": 2139.0,
    "end_time": 2139.52,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 23,
    "text": "ああ。",
    "start_time": 2140.25,
    "end_time": 2140.75,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
