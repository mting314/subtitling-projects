[
  {
    "id": 0,
    "text": "そうだよね。",
    "start_time": 1460.3,
    "end_time": 1461.36,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 1,
    "text": "暑いの私も苦手。",
    "start_time": 1461.48,
    "end_time": 1462.92,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "うん。",
    "start_time": 1463.12,
    "end_time": 1463.68,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 3,
    "text": "熱中症になっちゃうからね、気をつけててもね。",
    "start_time": 1463.8,
    "end_time": 1466.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "そうね。",
    "start_time": 1466.85,
    "end_time": 1467.35,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 5,
    "text": "あ、これから楽しみ、どんどん、うん、涼しくなってくれたらないいんですね。",
    "start_time": 1467.52,
    "end_time": 1473.44,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "ああ。",
    "start_time": 1470.73,
    "end_time": 1471.23,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 7,
    "text": "日が落ちるのが早くなってくるのもそれはそれで",
    "start_time": 1473.44,
    "end_time": 1476.76,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "エモしなるね。",
    "start_time": 1477.16,
    "end_time": 1478.12,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 9,
    "text": "そうだよね。",
    "start_time": 1478.68,
    "end_time": 1479.2,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "そろそろもう変わってくるかな。",
    "start_time": 1479.2,
    "end_time": 1481.16,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "9月入ったらだいぶね。",
    "start_time": 1481.16,
    "end_time": 1482.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "ね、早くなりそうで。",
    "start_time": 1482.8,
    "end_time": 1484.24,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 13,
    "text": "うん。",
    "start_time": 1484.24,
    "end_time": 1484.74,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 14,
    "text": "うん、うん、うん。",
    "start_time": 1484.76,
    "end_time": 1485.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 15,
    "text": "虫の虫の、そう、そう、そう。",
    "start_time": 1485.6,
    "end_time": 1487.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "鳴き声も変わるだろうから。",
    "start_time": 1487.6,
    "end_time": 1489.24,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 17,
    "text": "うん。",
    "start_time": 1489.29,
    "end_time": 1489.79,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 18,
    "text": "いいですね。",
    "start_time": 1490.04,
    "end_time": 1490.8,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 19,
    "text": "いや、みんないいな。",
    "start_time": 1490.88,
    "end_time": 1492.24,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 20,
    "text": "みんないいんですね。",
    "start_time": 1492.24,
    "end_time": 1493.52,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 21,
    "text": "おつだね。",
    "start_time": 1493.8,
    "end_time": 1494.32,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "おつ。",
    "start_time": 1494.43,
    "end_time": 1494.93,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 23,
    "text": "じゃ、どんどん行きましょうか。",
    "start_time": 1495.76,
    "end_time": 1497.16,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 24,
    "text": "はい、続いてはぽぽぽさんからです。",
    "start_time": 1497.52,
    "end_time": 1499.98,
    "speaker": "Minori Suzuki",
    "role": "host_meta"
  },
  {
    "id": 25,
    "text": "ありがとうございます。",
    "start_time": 1499.98,
    "end_time": 1501.2,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 26,
    "text": "ありがとうございます。",
    "start_time": 1501.32,
    "end_time": 1501.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 27,
    "text": "ほんいずみさん、すずきさん、こんまこんにご。",
    "start_time": 1501.88,
    "end_time": 1504.72,
    "speaker": "Minori Suzuki",
    "role": "listener_mail"
  },
  {
    "id": 28,
    "text": "こんまこんにご。",
    "start_time": 1504.84,
    "end_time": 1506.08,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "私の秋に楽しみなことはプロセカ感謝祭です。",
    "start_time": 1506.2,
    "end_time": 1509.56,
    "speaker": "Minori Suzuki",
    "role": "listener_mail"
  }
]