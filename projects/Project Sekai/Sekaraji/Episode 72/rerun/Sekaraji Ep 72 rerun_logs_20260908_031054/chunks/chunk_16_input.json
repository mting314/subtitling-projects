[
  {
    "id": 0,
    "text": "あ、情報がね。",
    "start_time": 929.16,
    "end_time": 930.0,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 1,
    "text": "情報が不思議、うん。",
    "start_time": 930.28,
    "end_time": 932.4,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "確かに。",
    "start_time": 930.65,
    "end_time": 931.15,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 3,
    "text": "そうね、無音です。",
    "start_time": 933.04,
    "end_time": 934.12,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "ああ。",
    "start_time": 934.33,
    "end_time": 934.83,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 5,
    "text": "チェックとかも仕事のチェックの時も",
    "start_time": 935.04,
    "end_time": 937.16,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "チェックの時も",
    "start_time": 937.28,
    "end_time": 938.56,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 7,
    "text": "無音かその作業BGMか、でもあんまりガンガン流さない。",
    "start_time": 939.16,
    "end_time": 944.4,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "本当にうっすら聞こえるくらい。",
    "start_time": 944.4,
    "end_time": 946.48,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 9,
    "text": "へえ、そうなんだ。",
    "start_time": 947.16,
    "end_time": 948.2,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 10,
    "text": "うん。",
    "start_time": 948.15,
    "end_time": 948.785,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "でも基本無音が好きかも。",
    "start_time": 948.785,
    "end_time": 950.64,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "うんうん。",
    "start_time": 950.65,
    "end_time": 951.15,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 13,
    "text": "物語を頭に入れる時は無音が好きかもです。",
    "start_time": 951.16,
    "end_time": 955.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "ああ。",
    "start_time": 955.81,
    "end_time": 956.31,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 15,
    "text": "うん。",
    "start_time": 956.65,
    "end_time": 957.375,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "漫画読む時とかもどどうしか?",
    "start_time": 957.375,
    "end_time": 959.56,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 17,
    "text": "私は結構音楽何かしら流しちゃうことが多いかな。",
    "start_time": 960.2,
    "end_time": 967.64,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 18,
    "text": "うん。",
    "start_time": 961.43,
    "end_time": 961.93,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 19,
    "text": "うんうん。",
    "start_time": 967.57,
    "end_time": 968.07,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "あとは本読む時によくなっちゃうんだけどその物語にあったなんとなくその洋楽とかBGMみたいな。",
    "start_time": 968.44,
    "end_time": 976.94,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 21,
    "text": "はいはい、ああ。",
    "start_time": 974.47,
    "end_time": 974.97,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "ああ。",
    "start_time": 976.65,
    "end_time": 977.15,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 23,
    "text": "この間はマヤ文明が舞台の作業を読んでたんだけど",
    "start_time": 976.94,
    "end_time": 981.2,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 24,
    "text": "いろんな本読んでるよね。",
    "start_time": 981.32,
    "end_time": 982.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "うん。",
    "start_time": 983.67,
    "end_time": 984.305,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 26,
    "text": "そん時はなんとなくこうフリー音源のなんかマヤ文明っぽいなんかこう音楽とか検索すると出てくるの。",
    "start_time": 984.305,
    "end_time": 993.76,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 27,
    "text": "うんうん。",
    "start_time": 988.07,
    "end_time": 988.57,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "うん。",
    "start_time": 992.71,
    "end_time": 993.21,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
