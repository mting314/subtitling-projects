[
  {
    "id": 0,
    "text": "北海道の海も見たい。",
    "start_time": 471.88,
    "end_time": 473.32,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 1,
    "text": "素敵です、本当に。",
    "start_time": 473.52,
    "end_time": 475.12,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "うん。",
    "start_time": 475.03,
    "end_time": 475.53,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 3,
    "text": "船で行くのすごいありだなって思った。",
    "start_time": 475.88,
    "end_time": 477.68,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "飛行機代と宿代を合わせると船で行った方がもしかしてちょっと安いまであるぐらいでそう、",
    "start_time": 477.68,
    "end_time": 486.52,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "うん。",
    "start_time": 478.73,
    "end_time": 479.23,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 6,
    "text": "そうなんだ。",
    "start_time": 485.75,
    "end_time": 486.25,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 7,
    "text": "なんか船酔いさえしなければ海好きな人はめっちゃぴったりだと思います。",
    "start_time": 486.52,
    "end_time": 492.08,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "大洗もいいって言うよね。",
    "start_time": 492.16,
    "end_time": 493.52,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 9,
    "text": "あ、そうなんだ。",
    "start_time": 493.64,
    "end_time": 494.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "ちゃんとそこはあの、本当船乗るだけだったからでもすごい空気も良くてちょっと短い間だったけどあと雨上がりだったから虹も出ててそう、",
    "start_time": 494.72,
    "end_time": 504.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "え?",
    "start_time": 503.73,
    "end_time": 504.23,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 12,
    "text": "空も澄んでて素敵だったんで、大洗もちゃんと観光したいな。",
    "start_time": 505.28,
    "end_time": 510.26,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "最高すぎ。",
    "start_time": 506.52,
    "end_time": 507.04,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 14,
    "text": "結構確かにあの、大洗に向かう人もいっぱいたからうんうんうんうん。",
    "start_time": 510.26,
    "end_time": 515.6,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 15,
    "text": "うん。",
    "start_time": 514.27,
    "end_time": 514.77,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 16,
    "text": "素敵な旅館多いらしい。",
    "start_time": 516.04,
    "end_time": 517.84,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 17,
    "text": "ああ、行きたいとこ増えちゃったね。",
    "start_time": 517.96,
    "end_time": 519.32,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "いや、いいよ。",
    "start_time": 519.43,
    "end_time": 519.93,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 19,
    "text": "いや、いいんですね。",
    "start_time": 520.4,
    "end_time": 521.54,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "ちゃんと夏の思い出あった2人でしたね。",
    "start_time": 521.54,
    "end_time": 523.64,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "ね、よかった。",
    "start_time": 523.76,
    "end_time": 524.52,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 22,
    "text": "ね。",
    "start_time": 524.39,
    "end_time": 524.89,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
]