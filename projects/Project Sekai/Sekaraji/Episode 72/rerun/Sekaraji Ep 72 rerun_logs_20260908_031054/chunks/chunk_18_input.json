[
  {
    "id": 0,
    "text": "なんかなんて言うんだ?",
    "start_time": 1058.46,
    "end_time": 1060.3,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 1,
    "text": "うん。",
    "start_time": 1058.87,
    "end_time": 1059.37,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "あのなんて言うの?",
    "start_time": 1060.3,
    "end_time": 1061.8,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 3,
    "text": "プロみたい、なんて言うの?",
    "start_time": 1061.8,
    "end_time": 1062.78,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 4,
    "text": "お酒の、お酒の今日はこの人に合うのはこれみたいな、",
    "start_time": 1062.78,
    "end_time": 1066.04,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 5,
    "text": "なんかそういうのなんて言うだっけ?",
    "start_time": 1066.04,
    "end_time": 1067.565,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 6,
    "text": "なんか",
    "start_time": 1067.565,
    "end_time": 1068.15,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 7,
    "text": "あ、え、あ、あの、マイスターじゃなくてあの",
    "start_time": 1068.12,
    "end_time": 1070.74,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "そういう感じのあのプロ。",
    "start_time": 1070.74,
    "end_time": 1073.46,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 9,
    "text": "プロね。",
    "start_time": 1072.55,
    "end_time": 1073.05,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 10,
    "text": "私も出てこなくなっちゃった。",
    "start_time": 1073.46,
    "end_time": 1074.84,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "今日のあなたはこれみたいな。",
    "start_time": 1075.52,
    "end_time": 1076.84,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 12,
    "text": "あ。",
    "start_time": 1076.69,
    "end_time": 1077.19,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 13,
    "text": "そう、本のそういう人みたいな。",
    "start_time": 1077.6,
    "end_time": 1079.04,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 14,
    "text": "うん、すごい。",
    "start_time": 1079.5,
    "end_time": 1080.0,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 15,
    "text": "自分の今のマインドにあったものっていつも探しちゃう。",
    "start_time": 1080.0,
    "end_time": 1084.24,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 16,
    "text": "すごいなあ。",
    "start_time": 1084.84,
    "end_time": 1085.96,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 17,
    "text": "本、本そうやって読める人すごい尊敬する。",
    "start_time": 1086.64,
    "end_time": 1089.72,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 18,
    "text": "ええ。",
    "start_time": 1090.4,
    "end_time": 1091.12,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 19,
    "text": "わかるよね、本ってね。",
    "start_time": 1091.24,
    "end_time": 1092.56,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "はい、ということで、睦月様ありがとうございました。",
    "start_time": 1093.84,
    "end_time": 1097.16,
    "speaker": "Minori Suzuki",
    "role": "host_meta"
  },
  {
    "id": 21,
    "text": "今回は以上でございます。",
    "start_time": 1097.16,
    "end_time": 1099.58,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 22,
    "text": "こんな感じでプロセカキャストに聞いてみたい質問やテーマをお待ちしています。",
    "start_time": 1099.58,
    "end_time": 1103.96,
    "speaker": "Minori Suzuki",
    "role": "host_meta"
  },
  {
    "id": 23,
    "text": "はい。",
    "start_time": 1104.08,
    "end_time": 1104.72,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
]