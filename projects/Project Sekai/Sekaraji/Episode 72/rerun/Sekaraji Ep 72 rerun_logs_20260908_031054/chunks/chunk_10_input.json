[
  {
    "id": 0,
    "text": "はい、じゃ、それでは、え、皆さんからのおたよりもご紹介していきたいなと思います。",
    "start_time": 525.56,
    "end_time": 532.04,
    "speaker": "Rina Honnizumi",
    "role": "host_meta",
    "corner": "Listener Mail"
  },
  {
    "id": 1,
    "text": "はい。",
    "start_time": 530.19,
    "end_time": 530.69,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 2,
    "text": "うん。",
    "start_time": 531.89,
    "end_time": 532.39,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 3,
    "text": "あ、そっかそっか。",
    "start_time": 532.72,
    "end_time": 533.96,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "紹介する前にあれですね、エンディングで我々も次回の出演キャストをに向けて連絡ノートでコメントを残していきたいと思います。",
    "start_time": 533.96,
    "end_time": 542.66,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "エンディングか、じゃ、考えておきましょう。",
    "start_time": 542.66,
    "end_time": 544.8,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "ね。",
    "start_time": 544.47,
    "end_time": 544.97,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 7,
    "text": "はい、ということで改めましてラジオネーム4Bさんからいただきました。",
    "start_time": 544.8,
    "end_time": 550.8,
    "speaker": "Rina Honnizumi",
    "role": "host_meta"
  },
  {
    "id": 8,
    "text": "ありがとうございます。",
    "start_time": 550.8,
    "end_time": 551.96,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 9,
    "text": "多分鉛筆?",
    "start_time": 552.24,
    "end_time": 553.16,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 10,
    "text": "きっとね。",
    "start_time": 553.36,
    "end_time": 554.02,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "濃いめのが好きなんだ。",
    "start_time": 554.02,
    "end_time": 555.28,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "ね。",
    "start_time": 555.4,
    "end_time": 555.96,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 13,
    "text": "え、本泉さん、鈴木さんこんもは、こんには。",
    "start_time": 556.32,
    "end_time": 559.28,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 14,
    "text": "こんには。",
    "start_time": 559.55,
    "end_time": 560.185,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 15,
    "text": "ありがとう。",
    "start_time": 560.185,
    "end_time": 560.92,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 16,
    "text": "ありがとうございます。",
    "start_time": 561.16,
    "end_time": 562.2,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 17,
    "text": "え、今年かき氷を食べていないことに気づきました。",
    "start_time": 562.2,
    "end_time": 565.4,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 18,
    "text": "外が暑くて全然外出する気がなかったのでそのせいだと思います。",
    "start_time": 565.92,
    "end_time": 569.76,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 19,
    "text": "きっとね。",
    "start_time": 569.83,
    "end_time": 570.33,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 20,
    "text": "月末にお祭りがあるのでそこで食べてこようと思っています。",
    "start_time": 571.16,
    "end_time": 574.96,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 21,
    "text": "お2人はかき氷食べましたか?",
    "start_time": 574.96,
    "end_time": 577.08,
    "speaker": "Rina Honnizumi",
    "role": "listener_mail"
  },
  {
    "id": 22,
    "text": "ということで",
    "start_time": 577.6,
    "end_time": 578.12,
    "speaker": "Minori Suzuki",
    "role": "host_meta"
  },
  {
    "id": 23,
    "text": "ちょうどこのラジオ配信されるぐらいにお祭りあるのかな。",
    "start_time": 578.28,
    "end_time": 582.36,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 24,
    "text": "確かに。",
    "start_time": 581.15,
    "end_time": 581.65,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 25,
    "text": "食べれたかな。",
    "start_time": 582.48,
    "end_time": 583.08,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 26,
    "text": "ね、いいですね。",
    "start_time": 584.4,
    "end_time": 585.68,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 27,
    "text": "食べました?",
    "start_time": 585.68,
    "end_time": 586.92,
    "speaker": "Rina Honnizumi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "食べてないかも。",
    "start_time": 587.56,
    "end_time": 588.52,
    "speaker": "Minori Suzuki",
    "role": "host"
  },
  {
    "id": 29,
    "text": "私も。",
    "start_time": 588.6,
    "end_time": 589.8,
    "speaker": "Rina Honnizumi",
    "role": "host"
  }
]