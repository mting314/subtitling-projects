[
  {
    "id": 0,
    "text": "あれ、本を読むことは得意な方?",
    "start_time": 913.24,
    "end_time": 915.54,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "よ、うん、なんかはまる時期はあるというか本読みたいみたいな時期あるんですけど結構積んじゃうかもしれないですね。",
    "start_time": 915.54,
    "end_time": 923.72,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 2,
    "text": "モードに入らないと全然なんか読みたくないというか。",
    "start_time": 923.72,
    "end_time": 926.88,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 3,
    "text": "私読破した本が本当少ないんだよ。",
    "start_time": 927.32,
    "end_time": 929.32,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 4,
    "text": "え、そうなんすね。",
    "start_time": 929.72,
    "end_time": 930.52,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "本を読みたいって思う瞬間がそんなにないんだよ。",
    "start_time": 930.84,
    "end_time": 934.0,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 6,
    "text": "え、そうなんすね。",
    "start_time": 934.28,
    "end_time": 935.52,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "そう。",
    "start_time": 935.41,
    "end_time": 935.995,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 8,
    "text": "活字といえばいいの?",
    "start_time": 935.995,
    "end_time": 937.48,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 9,
    "text": "活字。",
    "start_time": 937.57,
    "end_time": 938.07,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "活字が結構苦手で。",
    "start_time": 938.28,
    "end_time": 940.12,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 11,
    "text": "そうなんですね。",
    "start_time": 940.33,
    "end_time": 940.83,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "昔から苦手意識はね、いっぱいあるから本読める人本当尊敬するんだよ。",
    "start_time": 941.2,
    "end_time": 946.08,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 13,
    "text": "いや、すごいですね。",
    "start_time": 946.2,
    "end_time": 947.04,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "このシュレーディンガーの猫さん。",
    "start_time": 947.04,
    "end_time": 948.54,
    "speaker": "Ruriko Noguchi",
    "role": "host_meta"
  },
  {
    "id": 15,
    "text": "図書委員に入った。",
    "start_time": 948.54,
    "end_time": 949.6,
    "speaker": "Ruriko Noguchi",
    "role": "listener_mail"
  },
  {
    "id": 16,
    "text": "寧々ちゃんと一緒だ。",
    "start_time": 949.8,
    "end_time": 951.0,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 17,
    "text": "寧々と一緒。",
    "start_time": 951.0,
    "end_time": 951.96,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 18,
    "text": "私も図書委員にはいたんだけどね。",
    "start_time": 951.96,
    "end_time": 953.88,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 19,
    "text": "あ、本当ですか?",
    "start_time": 954.08,
    "end_time": 954.88,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 20,
    "text": "うん。",
    "start_time": 954.79,
    "end_time": 955.29,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 21,
    "text": "いたんだ。",
    "start_time": 955.84,
    "end_time": 956.48,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 22,
    "text": "でもなんかあんまり本には",
    "start_time": 956.6,
    "end_time": 958.52,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 23,
    "text": "なんかたこ焼きまんとか",
    "start_time": 958.52,
    "end_time": 960.52,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 24,
    "text": "読みやすい。",
    "start_time": 961.87,
    "end_time": 962.37,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 25,
    "text": "そうそうそう。",
    "start_time": 962.53,
    "end_time": 963.03,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 26,
    "text": "かいけつゾロリとか。",
    "start_time": 963.24,
    "end_time": 964.12,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 27,
    "text": "絵が描いてま、面白いんですよね。",
    "start_time": 964.28,
    "end_time": 965.52,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "やっぱ結局ね。",
    "start_time": 965.52,
    "end_time": 966.28,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "いっぱいこまったさんわかったさんの料理のやつとか。",
    "start_time": 966.44,
    "end_time": 969.24,
    "speaker": "Machico",
    "role": "host"
  }
]