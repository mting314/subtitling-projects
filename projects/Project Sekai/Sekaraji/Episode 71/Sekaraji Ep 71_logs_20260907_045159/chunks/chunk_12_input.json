[
  {
    "id": 0,
    "text": "ということでここで1曲お届けいたします。",
    "start_time": 661.04,
    "end_time": 664.66,
    "speaker": "Ruriko Noguchi",
    "role": "host_meta",
    "corner": "Song"
  },
  {
    "id": 1,
    "text": "え、こちらの曲はうかろくさんに書いていただきました。",
    "start_time": 664.66,
    "end_time": 669.28,
    "speaker": "Ruriko Noguchi",
    "role": "host_meta"
  },
  {
    "id": 2,
    "text": "Leonideのイベントエコーオブアプレイヤーの書き下ろし楽曲となっております。",
    "start_time": 669.28,
    "end_time": 674.36,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 3,
    "text": "それではお聞きください。",
    "start_time": 674.36,
    "end_time": 676.12,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "天秤指先で触れて。",
    "start_time": 676.12,
    "end_time": 677.88,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "努力すれば強く願えばどちらもなせる気でいた。",
    "start_time": 686.24,
    "end_time": 691.2,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 6,
    "text": "あにたけの時間のせいを払うけど単位なって私が触れたら賢かったら時が止まってくれたらえ、",
    "start_time": 691.88,
    "end_time": 703.14,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 7,
    "text": "空と書いて現実逃避自分に言い訳だそうな。",
    "start_time": 703.14,
    "end_time": 708.68,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 8,
    "text": "望みが遠ざかってしまう。",
    "start_time": 709.92,
    "end_time": 712.28,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 9,
    "text": "いやだよ。",
    "start_time": 713.24,
    "end_time": 714.36,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 10,
    "text": "いやだ追ってかないで。",
    "start_time": 715.76,
    "end_time": 718.44,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 11,
    "text": "ふたかから注がれてく世界を淀ませないようにまだ抗ってた。",
    "start_time": 718.44,
    "end_time": 730.4,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 12,
    "text": "回らない。",
    "start_time": 731.68,
    "end_time": 733.16,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 13,
    "text": "バルブを回して大丈夫と繰り返し私に暗示を施した。",
    "start_time": 734.2,
    "end_time": 742.64,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 14,
    "text": "決められない決めたくないどちらも大事なんだから決めなくちゃ選ばなきゃそんなの分かってるも。",
    "start_time": 745.0,
    "end_time": 755.56,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 15,
    "text": "答えられなくて閉じ込めてごめんねと小さく",
    "start_time": 756.2,
    "end_time": 763.08,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 16,
    "text": "告げる",
    "start_time": 764.55,
    "end_time": 765.05,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 17,
    "text": "流れのままに濁ってく世界は詰えながら心までたどるぬく",
    "start_time": 767.28,
    "end_time": 778.68,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 18,
    "text": "かわで世界と私を見てた。",
    "start_time": 780.28,
    "end_time": 784.92,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 19,
    "text": "目をそらしこれで良かったのと呟いた。",
    "start_time": 785.84,
    "end_time": 789.16,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 20,
    "text": "良かったんだよ。",
    "start_time": 794.4,
    "end_time": 795.76,
    "speaker": "2",
    "role": "host"
  },
  {
    "id": 21,
    "text": "セカラじ。",
    "start_time": 809.2,
    "end_time": 809.76,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  }
]