[
  {
    "id": 0,
    "text": "謎の漫画を描いて。",
    "start_time": 1560.04,
    "end_time": 1561.16,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "楽しいことする。",
    "start_time": 1562.68,
    "end_time": 1563.72,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 2,
    "text": "そんなことしかしてなかったよ。",
    "start_time": 1564.56,
    "end_time": 1566.24,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 3,
    "text": "確かにアウトプットをしている学生、かっこよすぎ。",
    "start_time": 1566.56,
    "end_time": 1569.64,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 4,
    "text": "凄い、もうあとはバイトばっかりだったわ。",
    "start_time": 1569.8,
    "end_time": 1572.04,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 5,
    "text": "ああ、もう私もなんか芝居とかばっか見に行って。",
    "start_time": 1572.16,
    "end_time": 1575.16,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 6,
    "text": "ああ、でもその時からお芝居興味あったんだ。",
    "start_time": 1575.36,
    "end_time": 1577.44,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "そうです。",
    "start_time": 1577.3,
    "end_time": 1577.8,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 8,
    "text": "舞台見るのが好きだったんだよ。",
    "start_time": 1577.8,
    "end_time": 1579.2,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 9,
    "text": "お笑い見たりとか、なんか何かを見るをずっとしてた。",
    "start_time": 1579.2,
    "end_time": 1582.16,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 10,
    "text": "でも本当お笑い芸人さんてさ、またその舞台っていう舞台とは違うけどさ、",
    "start_time": 1582.72,
    "end_time": 1587.4,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 11,
    "text": "やっぱ独特の演技とお芝居だよね。",
    "start_time": 1587.4,
    "end_time": 1589.6,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "あ、分かります、分かります。",
    "start_time": 1590.0,
    "end_time": 1590.8,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 13,
    "text": "だからなんかお笑い芸人さんがそのドラマだったり声優だったり得意なのなんか分かるって思う。",
    "start_time": 1590.92,
    "end_time": 1596.72,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "いや、分かります。",
    "start_time": 1596.82,
    "end_time": 1597.32,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 15,
    "text": "なんか凄い、いっつも凄い。",
    "start_time": 1597.32,
    "end_time": 1599.28,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 16,
    "text": "想像力が豊かと言うか。",
    "start_time": 1599.64,
    "end_time": 1601.24,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 17,
    "text": "確かに。",
    "start_time": 1601.23,
    "end_time": 1601.945,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 18,
    "text": "コントとかもやっぱ面白いですよね。",
    "start_time": 1601.945,
    "end_time": 1603.655,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 19,
    "text": "演技力ない。",
    "start_time": 1603.655,
    "end_time": 1604.33,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 20,
    "text": "テンポ感とか凄い独特だから。",
    "start_time": 1604.36,
    "end_time": 1606.4,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 21,
    "text": "好きだったな。",
    "start_time": 1606.41,
    "end_time": 1606.91,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 22,
    "text": "え、確かにそういうのやっぱりアウトプット、インプットだね。",
    "start_time": 1607.4,
    "end_time": 1610.12,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 23,
    "text": "インプットですね。",
    "start_time": 1610.48,
    "end_time": 1611.08,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 24,
    "text": "インプットいっぱいしよう。",
    "start_time": 1611.2,
    "end_time": 1612.68,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "ね。",
    "start_time": 1612.55,
    "end_time": 1613.225,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 26,
    "text": "そして作曲にも、歌にも生かしていただいて。",
    "start_time": 1613.225,
    "end_time": 1616.08,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 27,
    "text": "素晴らしい。",
    "start_time": 1616.49,
    "end_time": 1616.99,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 28,
    "text": "素晴らしいです。",
    "start_time": 1617.04,
    "end_time": 1618.44,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 29,
    "text": "うん。",
    "start_time": 1618.27,
    "end_time": 1618.77,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  }
]