[
  {
    "id": 0,
    "text": "いや、ないんじゃない、もう。",
    "start_time": 1480.92,
    "end_time": 1482.44,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 1,
    "text": "面白い。",
    "start_time": 1482.56,
    "end_time": 1483.295,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 2,
    "text": "凄いですね。",
    "start_time": 1483.295,
    "end_time": 1484.01,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 3,
    "text": "曲を作ったり歌の練習。",
    "start_time": 1484.12,
    "end_time": 1486.08,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 4,
    "text": "うわあ、いいなあ。",
    "start_time": 1486.2,
    "end_time": 1487.52,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 5,
    "text": "え、でもさ、なんかその歌の練習とかこれからレベルアップしていくって中でさ、",
    "start_time": 1487.64,
    "end_time": 1492.9,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 6,
    "text": "もちろん基礎は大切だと思うの、腹式。",
    "start_time": 1492.9,
    "end_time": 1495.72,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 7,
    "text": "気をつけなきゃとかさ、なんかこういうところって言うよりかは、",
    "start_time": 1495.72,
    "end_time": 1499.92,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 8,
    "text": "今は楽しくさ、自分がどの状態で気持ちよく歌えるかって言うところを固めていって、",
    "start_time": 1499.92,
    "end_time": 1507.0,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 9,
    "text": "そこから腹式だったりをサブで考えた方がもしかしたら自由に歌が歌えるんじゃないかな。",
    "start_time": 1507.0,
    "end_time": 1513.96,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 10,
    "text": "素晴らしい。",
    "start_time": 1514.12,
    "end_time": 1514.92,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 11,
    "text": "なんかそんな気がする。",
    "start_time": 1515.08,
    "end_time": 1516.32,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 12,
    "text": "素晴らしいアドバイスです。",
    "start_time": 1516.72,
    "end_time": 1518.0,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 13,
    "text": "なんかね、凝り固まっちゃったらね、自分の可能性も狭くなっちゃうから、",
    "start_time": 1519.32,
    "end_time": 1524.12,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 14,
    "text": "今は自由にやってもいいような気するけどな。",
    "start_time": 1524.12,
    "end_time": 1526.92,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 15,
    "text": "いずれね、その色々考えなきゃいけない時期が来るかもしれないから。",
    "start_time": 1527.04,
    "end_time": 1530.82,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 16,
    "text": "今しか好き勝手歌えないとか思っちゃって、好きに歌ってもいいかもしれないですよ。",
    "start_time": 1530.82,
    "end_time": 1535.56,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 17,
    "text": "もしね、ボイトレとかでそういうのなんか試験みたいな感じであるんだったら、",
    "start_time": 1535.64,
    "end_time": 1539.24,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 18,
    "text": "確かに身につけた方がいいけど。",
    "start_time": 1539.24,
    "end_time": 1541.24,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 19,
    "text": "いや、でも偉いですね。",
    "start_time": 1541.44,
    "end_time": 1542.72,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 20,
    "text": "腹式とかもちゃんと意識して。",
    "start_time": 1542.72,
    "end_time": 1544.48,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 21,
    "text": "本当に音楽が好きなんだね。",
    "start_time": 1545.36,
    "end_time": 1547.22,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 22,
    "text": "曲を作ったりさあ。",
    "start_time": 1547.22,
    "end_time": 1549.16,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 23,
    "text": "ええ。",
    "start_time": 1549.16,
    "end_time": 1550.32,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 24,
    "text": "高校生だよ。",
    "start_time": 1550.52,
    "end_time": 1551.6,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 25,
    "text": "ええ、何してたんだろう、私は一体。",
    "start_time": 1551.72,
    "end_time": 1553.6,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 26,
    "text": "何にも生み出さなかったよ、私。",
    "start_time": 1554.4,
    "end_time": 1556.0,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 27,
    "text": "私もですね。",
    "start_time": 1556.6,
    "end_time": 1557.24,
    "speaker": "Machico",
    "role": "host"
  },
  {
    "id": 28,
    "text": "余計なものしか生み出さなかった。",
    "start_time": 1557.32,
    "end_time": 1558.96,
    "speaker": "Ruriko Noguchi",
    "role": "host"
  },
  {
    "id": 29,
    "text": "そんなことはない。",
    "start_time": 1559.08,
    "end_time": 1559.84,
    "speaker": "Machico",
    "role": "host"
  }
]