    "id": 1,
    "text": "。"
  },
  {
    "id": 2,
    "text": "これなんかいちちゃんも髪短いですよ。"
  },
  {
    "id": 3,
    "text": "なんかいいです。"
  },
  {
    "id": 4,
    "text": "ちょっとなんかアンニュイな微笑みみたいな感じ。"
  },
  {
    "id": 5,
    "text": "、また背景も可愛いんです。"
  },
  {
    "id": 6,
    "text": "。"
  },
  {
    "id": 7,
    "text": "、なんかこんな世界旅してみたい。"
  },
  {
    "id": 8,
    "text": "ふふすごく。"
  },
  {
    "id": 9,
    "text": "、なんかいちちゃんもこのお洋服もすごい。"
  },
  {
    "id": 10,
    "text": "めちゃめちゃ細かいところまで作り込まれています。"
  },
  {
    "id": 11,
    "text": "髪短いのもいいです。"
  },
  {
    "id": 12,
    "text": "そして駒もいい表情して。"
  },
  {
    "id": 13,
    "text": "いい。"
  },
  {
    "id": 14,
    "text": "汗したたってます。"
  },
  {
    "id": 15,
    "text": "、なんかまっすぐなのか、まなざしめっちゃいいよ。"
  },
  {
    "id": 16,
    "text": "透き通って。"
  },
  {
    "id": 17,
    "text": "。"
  },
  {
    "id": 18,
    "text": "なんか声優のオファーとか来るじゃないですか。"
  },
  {
    "id": 19,
    "text": "。"
  },
  {
    "id": 20,
    "text": "なんかこの透き通る爽やかさどうです?"
  },
  {
    "id": 21,
    "text": "うちのいち。"
  },
  {
    "id": 22,
    "text": "いいです。"
  },
  {
    "id": 23,
    "text": "マイクが似合うねっ。"
  },
  {
    "id": 24,
    "text": "美人がいい。"
  },
  {
    "id": 25,
    "text": "本当。"
  },
  {
    "id": 26,
    "text": "汗もちゃんとあるの。"
  },
  {
    "id": 27,
    "text": "、本当そうだよ。"
  },
  {
    "id": 28,
    "text": "汗もしたたるいい女って書いてくれて。"
  },
  {
    "id": 29,
    "text": "、そし、、ごめん。"
  }
]