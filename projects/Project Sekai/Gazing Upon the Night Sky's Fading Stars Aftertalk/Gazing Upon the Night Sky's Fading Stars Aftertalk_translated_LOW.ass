Dialogue: 0,1:02:10.90,1:02:11.14,Default,host,0,0,0,,.
Dialogue: 0,1:02:11.14,1:02:11.38,Default,host,0,0,0,,.
Dialogue: 0,1:02:11.38,1:02:11.62,Default,host,0,0,0,,.
Dialogue: 0,1:02:11.62,1:02:11.86,Default,host,0,0,0,,.
Dialogue: 0,1:02:11.86,1:02:12.10,Default,host,0,0,0,,.
Dialogue: 0,1:02:12.10,1:02:12.34,Default,host,0,0,0,,.
Dialogue: 0,1:02:12.34,1:02:12.58,Default,host,0,0,0,,.
Dialogue: 0,1:02:12.58,1:02:12.82,Default,host,0,0,0,,.
