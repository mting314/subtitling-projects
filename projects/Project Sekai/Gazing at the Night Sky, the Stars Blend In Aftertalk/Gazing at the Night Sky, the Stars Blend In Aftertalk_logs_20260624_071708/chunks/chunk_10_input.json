[
  {
    "id": 0,
    "text": "同じ部屋の文ちゃん、退院するんだよ。"
  },
  {
    "id": 1,
    "text": "、"
  },
  {
    "id": 2,
    "text": "間に合うか?"
  },
  {
    "id": 3,
    "text": "、お母さんは退院の手続きしてくる。"
  },
  {
    "id": 4,
    "text": "そのまま1階で待ってる。"
  },
  {
    "id": 5,
    "text": "。"
  },
  {
    "id": 6,
    "text": "、司さんには少し本音言えてよかっ。"
  },
  {
    "id": 7,
    "text": "、"
  },
  {
    "id": 8,
    "text": "文。"
  },
  {
    "id": 9,
    "text": "これで明日から一緒に学校行ける。"
  },
  {
    "id": 10,
    "text": "文化祭のお化け屋敷も一緒にできそうでよかっ。"
  },
  {
    "id": 11,
    "text": "。"
  },
  {
    "id": 12,
    "text": "みんなとお化け屋敷する、楽しみだ。"
  },
  {
    "id": 13,
    "text": "、退院を見送り先生に挨拶してくれるんだ。"
  },
  {
    "id": 14,
    "text": "これからいっぱい遊ぼう。"
  },
  {
    "id": 15,
    "text": "、"
  },
  {
    "id": 16,
    "text": "?"
  },
  {
    "id": 17,
    "text": "咲。"
  },
  {
    "id": 18,
    "text": "検査終わったんだ。"
  },
  {
    "id": 19,
    "text": "。"
  },
  {
    "id": 20,
    "text": "ちょっと遅くなっちゃった、間に合ってよかっ。"
  },
  {
    "id": 21,
    "text": "、お。"
  },
  {
    "id": 22,
    "text": "。"
  },
  {
    "id": 23,
    "text": "、"
  },
  {
    "id": 24,
    "text": "ここだけで。"
  },
  {
    "id": 25,
    "text": "本当、この台詞が辛いって書いてくれ。"
  },
  {
    "id": 26,
    "text": "?"
  },
  {
    "id": 27,
    "text": "咲ちゃんがたくさんお喋りしてくれた、いつも楽しくて入院、"
  },
  {
    "id": 28,
    "text": "あんまり寂しくなかったん。"
  },
  {
    "id": 29,
    "text": "だから本当、本当、。"
  }
]