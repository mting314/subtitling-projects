    "text": "そして"
  },
  {
    "id": 1,
    "text": "。"
  },
  {
    "id": 2,
    "text": "ほな。"
  },
  {
    "id": 3,
    "text": "綺麗。"
  },
  {
    "id": 4,
    "text": "。"
  },
  {
    "id": 5,
    "text": "、この、あの、マント?"
  },
  {
    "id": 6,
    "text": "?"
  },
  {
    "id": 7,
    "text": "スカートっていう言い方でいい?"
  },
  {
    "id": 8,
    "text": "この裾のところのディテールがすごいんです。"
  },
  {
    "id": 9,
    "text": "そうし、なんと美しい横顔。"
  },
  {
    "id": 10,
    "text": "めちゃめちゃ。"
  },
  {
    "id": 11,
    "text": "なんかこれよく見たら、"
  },
  {
    "id": 12,
    "text": "そっ、グラデーションになってるから星もついていて、こうなんていう、"
  },
  {
    "id": 13,
    "text": "マントの内側にもすごい装飾されてます。"
  },
  {
    "id": 14,
    "text": "、すごく?"
  },
  {
    "id": 15,
    "text": "。"
  },
  {
    "id": 16,
    "text": "タロットみたいな。"
  },
  {
    "id": 17,
    "text": "、そうなん。"
  },
  {
    "id": 18,
    "text": "。"
  },
  {
    "id": 19,
    "text": "大人っぽい、美しい。"
  },
  {
    "id": 20,
    "text": "策も。"
  },
  {
    "id": 21,
    "text": "、、本当。"
  },
  {
    "id": 22,
    "text": "それ。"
  },
  {
    "id": 23,
    "text": "策も可愛い。"
  },
  {
    "id": 24,
    "text": "、横からのアングル綺麗で見惚れ。"
  },
  {
    "id": 25,
    "text": "本当にその通り。"
  },
  {
    "id": 26,
    "text": "そして。"
  },
  {
    "id": 27,
    "text": "。"
  },
  {
    "id": 28,
    "text": "。"
  },
  {
    "id": 29,
    "text": "ママみが溢れて。"
  }
