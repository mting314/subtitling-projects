  {
    "id": 2,
    "text": "こっちこそだ。"
  },
  {
    "id": 3,
    "text": "これ、学校生活楽しんで。"
  },
  {
    "id": 4,
    "text": "。"
  },
  {
    "id": 5,
    "text": "それ、また。"
  },
  {
    "id": 6,
    "text": "ここでおめでとうって言えるのが咲ちゃんの強さでも。"
  },
  {
    "id": 7,
    "text": "明日からは学校。"
  },
  {
    "id": 8,
    "text": "よかった。"
  },
  {
    "id": 9,
    "text": "文化祭、どんな感じなのか分かんないけど"
  },
  {
    "id": 10,
    "text": "きっとすごく楽しいんだろう。"
  },
  {
    "id": 11,
    "text": "、そんな顔しないでってなっ。"
  },
  {
    "id": 12,
    "text": "。"
  },
  {
    "id": 13,
    "text": "熱"
  },
  {
    "id": 14,
    "text": "朝よりはちょっと下がったか。"
  },
  {
    "id": 15,
    "text": "薬飲んで安静にしてれ、すぐ良くなるって先生は言ってた。"
  },
  {
    "id": 16,
    "text": "静かだ今日はお父さん達も来れないって言ってたっ。"
  },
  {
    "id": 17,
    "text": "。"
  },
  {
    "id": 18,
    "text": "いちゃん達から連絡来てないか?"
  },
  {
    "id": 19,
    "text": "、咲ちゃんも司ちゃん見ているか。"
  },
  {
    "id": 20,
    "text": "、その通り。"
  },
  {
    "id": 21,
    "text": "前のクラスのグループ。"
  },
  {
    "id": 22,
    "text": "みんなでフルーツ狩りに行ってるん。"
  },
  {
    "id": 23,
    "text": "イチゴすごく大きくて美味し。"
  },
  {
    "id": 24,
    "text": "そういえ、去年クラスのみんなで行きたいねってメッセージ来てたっ。"
  },
  {
    "id": 25,
    "text": "向こうは"
  },
  {
    "id": 26,
    "text": "天気いい。"
  },
  {
    "id": 27,
    "text": "こっちは雨降ってんの。"
  },
  {
    "id": 28,
    "text": "私は私だけずっと"
  },
  {
    "id": 29,
    "text": "このままなのか?"
  }
]